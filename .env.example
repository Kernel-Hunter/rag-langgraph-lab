# Copy this file to .env and fill in the keys you have. Never commit .env.

# Chat model: openai | deepseek | ollama
LLM_PROVIDER=deepseek
# Optional. Defaults: gpt-4.1-nano (openai), deepseek-chat (deepseek), gemma3 (ollama)
# LLM_MODEL=

# Embeddings: openai | ollama | huggingface | fake
# DeepSeek has no embeddings API, so pair it with openai, ollama or huggingface.
# "fake" needs no key and no network, but retrieval quality is random. Use it only for smoke tests.
EMBEDDINGS_PROVIDER=huggingface
# Optional. Defaults: text-embedding-3-small (openai), nomic-embed-text (ollama),
# sentence-transformers/all-MiniLM-L6-v2 (huggingface)
# EMBEDDINGS_MODEL=

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
