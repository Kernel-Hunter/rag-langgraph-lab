# Vesper reads API keys from ~/.vesper/.env, which `vesper` (/key) and the desktop app
# (Settings, Models) both write. Set them there, or export them in your shell.
# Variables set in the shell win over the file.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional: web_search uses Brave or Tavily when a key is set, DuckDuckGo otherwise.
# BRAVE_API_KEY=
# TAVILY_API_KEY=
